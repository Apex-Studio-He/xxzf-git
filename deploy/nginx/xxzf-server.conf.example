# Put the two limit zones in nginx's http {} block.
limit_req_zone $binary_remote_addr zone=zundu_api_per_ip:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=zundu_conn_per_ip:10m;

server {
    listen 443 ssl http2;
    server_name example.com;

    # Configure your own certificate paths or use your ACME client.
    ssl_certificate /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    include /etc/nginx/xxzf_public_routes.inc;
}
