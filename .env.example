# Copy this file OUTSIDE the repository, replace every example value, then
# load it only in the service account that runs XXZF. Never commit the copy.
HOST=127.0.0.1
PORT=8787
DATA_DIR=/var/lib/xxzf
XXZF_TOKEN_FILE=/var/lib/xxzf/notify-token.txt
XXZF_AUDIT_DIR=/var/lib/xxzf/notification_archive
XXZF_DIAGNOSTIC_DIR=/var/lib/xxzf/diagnostics
XXZF_BARK_SECRET_FILE=/var/lib/xxzf/bark-secrets.json
XXZF_APK_FILE=/opt/xxzf/dist/NotifyBridge-release.apk

# Public HTTPS address used by the Android/macOS/Windows clients.
XXZF_PUBLIC_BASE=https://example.com/xxzf
XXZF_PUBLIC_ORIGIN=https://example.com
XXZF_BARK_BIND_PAGE=https://example.com/xxzf/bark/

# Keep the official Bark API unless you intentionally self-host Bark Server.
XXZF_BARK_ALLOWED_ORIGINS=https://api.day.app
